{
  "name": "Evolingo UI Kit",
  "version": "1.2.0",
  "status": "integrated",
  "purpose": "Canonical Apple Neutral and ChatGPT iOS-like mobile UI. AI-readable source of truth for new UI components.",
  "entrypoints": {
    "react": "app/evo-ui-kit/index.ts",
    "tokens": "app/evo-ui-kit/tokens.css",
    "components": [
      "app/evo-ui-kit/button.tsx",
      "app/evo-ui-kit/bottom-sheet.tsx",
      "app/evo-ui-kit/settings.tsx"
    ],
    "demos": [
      "app/evo-ui-kit/bottom-sheet-demo.tsx",
      "app/reference-screens.tsx",
      "app/evolingo-buttons-v2.tsx",
      "app/evolingo-menus-demo.tsx"
    ],
    "documentation": "UI_LIBRARY.md",
    "agentInstructions": "AGENTS.md",
    "siteTheme": "app/evo-ui-kit/site-theme.css"
  },
  "tokens": {
    "colors": {
      "canvas": "#FFFFFF",
      "surface": "#F5F5F7",
      "raised": "#FFFFFF",
      "text": "#202127",
      "muted": "#8E8E93",
      "border": "#E5E5EA",
      "borderStrong": "#D1D1D6",
      "primary": "#202127",
      "onPrimary": "#FFFFFF",
      "link": "#007AFF",
      "success": "#34C759",
      "danger": "#FF3B30"
    },
    "radiiPx": {
      "small": 10,
      "medium": 14,
      "card": 16,
      "sheetTop": 26,
      "pill": 999
    },
    "spacingPx": [
      4,
      8,
      12,
      16,
      20,
      24
    ],
    "controlSizePx": {
      "primaryHeight": 50,
      "compactHeight": 44,
      "iconSize": 44,
      "touchMinimum": 44
    },
    "icon": {
      "library": "lucide-react",
      "defaultSizePx": 20,
      "strokeWidth": 1.75
    },
    "typography": {
      "family": "-apple-system, BlinkMacSystemFont, SF Pro Text, Inter, system-ui, sans-serif",
      "controlFontSizePx": 15,
      "bodyFontSizePx": 14,
      "secondaryFontSizePx": 12
    },
    "motionMs": {
      "fast": 150,
      "standard": 240,
      "entrance": 280,
      "exit": 200
    },
    "layout": {
      "baselineViewportWidthPx": 390,
      "supportViewportWidthsPx": [
        360,
        390,
        430
      ],
      "contentMaxPx": 720,
      "sidePaddingPx": 16,
      "safeAreas": true,
      "overflow": "Never allow horizontal page scroll in a component preview"
    }
  },
  "button": {
    "module": "app/evo-ui-kit/button.tsx",
    "namedExport": "UIButton",
    "variants": [
      "primary",
      "secondary",
      "tertiary",
      "ghost",
      "danger",
      "glass"
    ],
    "sizes": [
      "standard",
      "compact",
      "icon"
    ],
    "defaultVariant": "primary",
    "defaultSize": "standard",
    "props": {
      "variant": "UIButtonVariant",
      "size": "UIButtonSize",
      "fullWidth": "boolean",
      "children": "ReactNode",
      "disabled": "boolean",
      "onClick": "ButtonHTMLAttributes['onClick']"
    },
    "rules": [
      "Use UIButton instead of ad-hoc buttons for new primary/secondary/compact/icon actions.",
      "Standard 50px, compact 44px, icon 44x44px; do not invent arbitrary heights.",
      "Long labels wrap. Full-width primary actions should use fullWidth.",
      "Button text and icons must remain visible at 360px viewport width."
    ]
  },
  "bottomSheet": {
    "module": "app/evo-ui-kit/bottom-sheet.tsx",
    "namedExport": "BottomSheet",
    "sizes": [
      "compact",
      "medium",
      "expanded"
    ],
    "defaultSize": "compact",
    "props": {
      "title": "string",
      "description": "string?",
      "children": "ReactNode",
      "footer": "ReactNode?",
      "onClose": "()=>void",
      "size": "BottomSheetSize",
      "dismissible": "boolean",
      "role": "dialog|alertdialog",
      "closeLabel": "string?"
    },
    "demos": [
      "actions",
      "context",
      "confirm",
      "create",
      "edit",
      "single",
      "multiple",
      "search",
      "filters",
      "date",
      "permission",
      "files",
      "wizard",
      "progress",
      "agent"
    ],
    "rules": [
      "All new application pop-ups use a viewport-bottom-attached BottomSheet (no centered or floating app pop-ups).",
      "Sheet outer shell spans full viewport width and has zero bottom gap; only top corners are rounded.",
      "Sheet background extends through the bottom safe area, while actions stay above the home indicator.",
      "Use a header and sticky footer; scroll only sheet content.",
      "Handle iOS Safari visual viewport keyboard changes; inputs must remain visible.",
      "Do not allow backdrop/swipe dismiss for unsaved forms or dangerous operations.",
      "Esc closes dismissible sheets, focus is constrained and restored, reduced motion is honored.",
      "The full-width shell remains on desktop; only content width is constrained."
    ]
  },
  "gallery": {
    "location": "Profile > Fejlesztői eszközök > UI Library",
    "categories": {
      "Buttons": "app/reference-screens.tsx",
      "Inputs": "app/reference-screens.tsx",
      "Cards": "app/evolingo-cards-demo.tsx",
      "Design System": "app/evolingo-design-system-demo.tsx",
      "Bottom Sheets & Forms": "app/evo-ui-kit/bottom-sheet-demo.tsx",
      "Menus & Settings": "app/evolingo-menus-demo.tsx",
      "Icons": "app/evolingo-icons-demo.tsx",
      "AI Components": "app/evolingo-ai-components-demo.tsx",
      "Typography": "app/reference-screens.tsx"
    }
  },
  "validation": {
    "mustBeMobileResponsive": true,
    "browserTargets": [
      "iOS Safari PWA",
      "desktop browser"
    ],
    "baselineWidths": [
      360,
      390,
      430,
      768,
      1280
    ],
    "focusVisible": true,
    "prefersReducedMotion": true,
    "demoSideEffects": "No real permissions, account changes, storage operations, or AI actions performed from gallery specimens.",
    "scope": "Gallery styling must not globally change production app screens until a component is opted in.",
    "build": "npm run build",
    "typecheck": "npm run typecheck",
    "reviewedBuilds": "Vercel Next.js build includes TypeScript; visual QA on physical iOS devices still recommended"
  },
  "useGuidance": "Read AGENTS.md and UI_LIBRARY.md then manifest.json. New UI must consume UIButton, BottomSheet and siteTheme tokens. Respect existing business logic.",
  "adoption": {
    "scope": "All primary Evolingo pages; legacy complex controls remain until manually migrated with real-device visual QA.",
    "siteTheme": "app/evo-ui-kit/site-theme.css",
    "mountedIn": "app/layout.tsx",
    "pages": [
      {
        "view": "chat",
        "file": "app/chat-interface.tsx",
        "changes": [
          "bottom-attached attachment menu",
          "UIButton Send control",
          "neutral composer styles"
        ]
      },
      {
        "view": "schedule",
        "file": "app/schedule.tsx",
        "changes": [
          "BottomSheet task creation",
          "BottomSheet task action list and delete confirmation",
          "UIButton creation controls"
        ]
      },
      {
        "view": "space",
        "file": "app/library-space.tsx",
        "changes": [
          "BottomSheet all library popups",
          "UIButton create/rename actions",
          "unified file cards and search fields",
          "bottom-sheet permanent delete confirmation"
        ]
      },
      {
        "view": "utility",
        "file": "app/tools-hub.tsx",
        "changes": [
          "BottomSheet integration info",
          "BottomSheet machine form",
          "in-sheet machine delete confirmation",
          "unified app cards"
        ]
      },
      {
        "view": "profile",
        "file": "app/reference-screens.tsx",
        "changes": [
          "Profile 3.0 compact avatar and identity action",
          "Three borderless sections (account, preferences, app) and standalone sign out",
          "Uses production UISettingsGroup/UISettingsRow/UISettingsSwitchRow from kit",
          "Preserves existing authentication, profile edit and notifications",
          "Removes duplicate Chat, Library and Schedule navigation from Profile (still available in app navigation)",
          "Uses existing BottomSheet for editing, accessibility settings and account information",
          "Functional per-device reduce motion accessibility setting"
        ]
      },
      {
        "view": "auth",
        "file": "app/reference-screens.tsx",
        "changes": [
          "unified primary action and fields via site tokens"
        ]
      },
      {
        "view": "brainstorm",
        "file": "app/brainstorm.tsx",
        "changes": [
          "BottomSheet creation form with UIButton submit",
          "unified task cards and controls"
        ]
      }
    ],
    "exclusions": [
      "Backend/API logic",
      "Existing session/data storage",
      "Existing sidebar gestures",
      "Native browser/system prompts not controlled by the app"
    ],
    "validationStatus": "Build/type-check via Vercel; device-specific visual regression tests remain recommended",
    "systemOverlays": [
      {
        "name": "Development notice",
        "source": "app/development-notice.tsx",
        "changes": [
          "Uses BottomSheet with standard UIButton",
          "No legacy green action button",
          "Preserves startup and dismissal behavior"
        ]
      },
      {
        "name": "Library permanent delete",
        "source": "app/library-space.tsx",
        "changes": [
          "Uses BottomSheet with destructive confirmation",
          "No browser-native confirm dialog"
        ]
      }
    ],
    "profileStyle": "app/profile-v3.css"
  },
  "buttonGallery": {
    "version": "2.0",
    "style": "Soft Monochrome",
    "source": "app/evolingo-buttons-v2.tsx",
    "stylesheet": "app/evolingo-buttons-v2.css",
    "families": [
      "core actions",
      "filled and outlined",
      "icon only",
      "icon and label",
      "floating actions",
      "chat controls",
      "segments",
      "selection chips",
      "filters and toggles",
      "split buttons",
      "navigation",
      "grouped actions",
      "async feedback",
      "voice and media",
      "file actions",
      "AI actions",
      "destructive",
      "accessibility"
    ],
    "palette": {
      "primary": "#202127",
      "onPrimary": "#FFFFFF",
      "secondary": "#FFFFFF",
      "tertiary": "#F2F2F4",
      "surface": "#F5F5F7",
      "segment": "#E9E9ED",
      "border": "#E5E5EA",
      "disabled": "#EAEAEE",
      "muted": "#8E8E93",
      "danger": "#FF3B30",
      "onDanger": "#FFFFFF"
    },
    "sizes": {
      "footer": 52,
      "standard": 48,
      "compact": 44,
      "icon": 44,
      "floating": 48,
      "chipVisual": 36,
      "minTouch": 44
    },
    "rules": [
      "Explicitly set foreground for filled dark and red buttons, including SVG stroke",
      "Use 44px minimum touch target",
      "Segments use dark readable unselected labels and white or graphite selected capsule",
      "Specimens are local UI Library examples; do not invoke production actions",
      "Use existing UIButton primitive for production actions"
    ]
  },
  "settings": {
    "module": "app/evo-ui-kit/settings.tsx",
    "stylesheet": "app/evo-ui-kit/settings.css",
    "exports": [
      "UISettingsGroup",
      "UISettingsRow",
      "UISettingsSwitchRow",
      "UISwitch"
    ],
    "design": "Borderless white-on-white ChatGPT x iOS Settings layout. Icons and text are graphite, muted descriptions and values, no filled group backgrounds.",
    "group": {
      "props": {
        "title": "string",
        "children": "ReactNode",
        "className": "string?"
      }
    },
    "row": {
      "props": {
        "icon": "LucideIcon",
        "title": "string",
        "description": "string?",
        "value": "string?",
        "trailing": "ReactNode?",
        "onClick": "()=>void?",
        "disabled": "boolean?",
        "destructive": "boolean?",
        "showChevron": "boolean?"
      },
      "behavior": "Navigation rows render buttons with chevrons. Non-action values render non-clickable divs without chevrons."
    },
    "toggle": {
      "exports": [
        "UISwitch",
        "UISettingsSwitchRow"
      ],
      "behavior": "Semantic role=switch, aria-checked, >=44px touch target, grayscale tracks; onChange delegates to caller."
    },
    "dimensions": {
      "rowMinHeightPx": 54,
      "iconSizePx": 20,
      "strokeWidth": 1.75,
      "switchTargetPx": 44,
      "sectionGapPx": 24
    },
    "examples": "Profile v3 and Menus & Settings gallery",
    "a11y": [
      "Never use nested interactive controls",
      "Role switch must announce checked state",
      "Disabled settings should not pretend to navigate",
      "Keep focus visible and touch targets at least 44px"
    ]
  }
}
